{
  "name": "shuttle-sync-platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run dev:backend\" \"node scripts/wait-for-api.mjs && npm run dev:frontend\"",
    "dev:backend": "dotnet run --project backend/ShuttleSync.Api.csproj --launch-profile http",
    "dev:frontend": "npm run dev --prefix frontend",
    "test:book": "playwright test tests/book_a_court.spec.js --project=chromium --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "concurrently": "^9.2.1"
  }
}
